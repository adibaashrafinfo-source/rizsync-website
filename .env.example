# ---------------------------------------------------------------------------
# Public — safe to expose to the browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.rizsync.com

# ---------------------------------------------------------------------------
# Transactional email (Resend) — server only
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (anti-spam)
# If both are empty the form still works and the CAPTCHA step is skipped,
# which keeps local development friction-free. Always set them in production.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Analytics — optional. Empty means the tag is not loaded at all.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Supabase — CMS content, admin login (/admin), media uploads, lead backup.
# Without these the site renders the bundled default content.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Preferred: bypasses RLS, so storeLead() can also read/update leads later.
SUPABASE_SERVICE_ROLE_KEY=
# Fallback if no service-role key is set: needs an anon-key "insert only"
# RLS policy on public.leads (see src/lib/leads.ts).
SUPABASE_ANON_KEY=
